rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Cheats collection: public read for all visitors
    match /cheats/{cheatId} {
      allow read: if true;
      allow create, update: if isValidId(cheatId);
      allow delete: if false;
    }

    // News collection: public read for all visitors
    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isValidId(newsId);
      allow delete: if false;
    }

    // Health check test
    match /test/{testId} {
      allow read: if true;
    }

    // User favorites sync and profile management
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update, delete: if isValidId(userId);
    }
  }
}
